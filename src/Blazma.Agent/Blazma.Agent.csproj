<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs ONLY inside the analysis sandbox. It references nothing from the host except
    Blazma.Contracts. Published self-contained for win-x64 because the sandbox has no
    .NET runtime:  dotnet publish src/Blazma.Agent -c Release -r win-x64
    The result is a plain folder with every file at its top level, NOT a single file: a
    single-file app has no assembly location (TraceEvent looks for its native helpers next to
    its DLL) and extracts native libraries at startup, while the agent runs from a read-only
    folder into which the host copies only the files at the top of the agent folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Blazma.Agent</RootNamespace>
    <AssemblyName>Blazma.Agent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blazma.Contracts\Blazma.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Blazma.Agent.Tests" />
  </ItemGroup>
</Project>
