<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Rules that fight the codebase style rather than catch bugs. -->
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1720;CA1724;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA2007;CA1031;CA1062;CA1303;CA1515;CA1002;CA1819;CA1056;CA1054;CA1055;CA1308;CA1812;CA1859;CA1822;CA1852;CA1869;CA1865;CA1866;CA1867;CA1847;CA1861;CA1806;CA1068;CA1823;CA1051;CA1873</NoWarn>

    <Product>Blazma Sandbox</Product>
    <Authors>mr-kateba</Authors>
    <Company>Blazma</Company>
    <Copyright>Copyright (C) 2026 mr-kateba</Copyright>
    <Version>0.1.2</Version>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
