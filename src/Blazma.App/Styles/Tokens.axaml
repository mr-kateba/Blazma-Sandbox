<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Blazma family tokens (shared with Crosshair, Boost, Get, NT and AI): graphite
    surfaces, soft borders, Blazma orange. These are the Dark defaults; ThemeService
    replaces the brushes at runtime for Midnight, Light and the accent choices.
    Risk colours are separate from the accent on purpose: orange is identity, never risk.
  -->
  <SolidColorBrush x:Key="BgBrush" Color="#121216" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#16161B" />
  <SolidColorBrush x:Key="PanelBrush" Color="#1C1C22" />
  <SolidColorBrush x:Key="PanelHoverBrush" Color="#26262E" />
  <SolidColorBrush x:Key="FieldBrush" Color="#0D0D10" />
  <SolidColorBrush x:Key="RuleBrush" Color="#2A2A33" />
  <SolidColorBrush x:Key="RuleStrongBrush" Color="#3A3A45" />
  <SolidColorBrush x:Key="TextBrush" Color="#F2F2F5" />
  <SolidColorBrush x:Key="MutedBrush" Color="#A0A0AB" />
  <SolidColorBrush x:Key="FaintBrush" Color="#6E6E7A" />
  <SolidColorBrush x:Key="OutlineBrush" Color="#C8C8CE" />
  <SolidColorBrush x:Key="HoverBrush" Color="#2E2E38" />

  <SolidColorBrush x:Key="AccentBrush" Color="#FF6D00" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#FF8A1F" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#24FF6D00" />
  <SolidColorBrush x:Key="AccentRimBrush" Color="#FFB066" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#F7F7F7" />

  <SolidColorBrush x:Key="OkBrush" Color="#34D399" />
  <SolidColorBrush x:Key="OkSoftBrush" Color="#10302A" />
  <SolidColorBrush x:Key="WarnBrush" Color="#FFB300" />
  <SolidColorBrush x:Key="WarnSoftBrush" Color="#33270A" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FF5252" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1A1C" />
  <SolidColorBrush x:Key="CriticalBrush" Color="#FF3B5C" />
  <SolidColorBrush x:Key="CriticalSoftBrush" Color="#3A1420" />
  <SolidColorBrush x:Key="InfoBrush" Color="#8C8C99" />
  <SolidColorBrush x:Key="DemoBgBrush" Color="#2A1D0D" />
  <SolidColorBrush x:Key="DemoBorderBrush" Color="#6B3D0C" />
  <SolidColorBrush x:Key="DemoTextBrush" Color="#FFB066" />

  <LinearGradientBrush x:Key="LogoBrush" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FFB300" />
    <GradientStop Offset="1" Color="#FF3D00" />
  </LinearGradientBrush>

  <FontFamily x:Key="BodyFont">avares://BlazmaSandbox/Assets/Fonts#IBM Plex Sans Arabic</FontFamily>
  <FontFamily x:Key="MonoFont">avares://BlazmaSandbox/Assets/Fonts#IBM Plex Mono</FontFamily>

  <CornerRadius x:Key="CardRadius">10</CornerRadius>
  <CornerRadius x:Key="KeyRadius">6</CornerRadius>
  <Thickness x:Key="CardPadding">18,16</Thickness>

  <!-- Recolouring the Fluent accent ramp retints toggles, sliders and focus rings in one place. -->
  <Color x:Key="SystemAccentColor">#FF6D00</Color>
  <Color x:Key="SystemAccentColorLight1">#FF8A1F</Color>
  <Color x:Key="SystemAccentColorLight2">#FFA54D</Color>
  <Color x:Key="SystemAccentColorLight3">#FFB066</Color>
  <Color x:Key="SystemAccentColorDark1">#E65100</Color>
  <Color x:Key="SystemAccentColorDark2">#C24400</Color>
  <Color x:Key="SystemAccentColorDark3">#9E3700</Color>

  <!-- Icons: simple stroke geometries in a 24x24 box. -->
  <StreamGeometry x:Key="IconDashboard">M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z</StreamGeometry>
  <StreamGeometry x:Key="IconNew">M12,4 V20 M4,12 H20</StreamGeometry>
  <StreamGeometry x:Key="IconHistory">M12,7 V12 L15,14 M4,12 A8,8 0 1 0 6.3,6.3 M4,4 V8 H8</StreamGeometry>
  <StreamGeometry x:Key="IconReports">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9,13 H16 M9,17 H16</StreamGeometry>
  <StreamGeometry x:Key="IconIntel">M12,3 A6,6 0 0 1 16,13.5 V17 H8 V13.5 A6,6 0 0 1 12,3 Z M9,21 H15</StreamGeometry>
  <StreamGeometry x:Key="IconSandbox">M12,3 L20,7.5 V16.5 L12,21 L4,16.5 V7.5 Z M4,7.5 L12,12 L20,7.5 M12,12 V21</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M12,8.5 A3.5,3.5 0 1 1 11.99,8.5 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M10.5,4 A6.5,6.5 0 1 1 10.49,4 Z M15.5,15.5 L20,20</StreamGeometry>
  <StreamGeometry x:Key="IconUpload">M12,15 V4 M7,9 L12,4 L17,9 M4,15 V20 H20 V15</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M5,12.5 L10,17 L19,7</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
  <StreamGeometry x:Key="IconChevron">M9,6 L15,12 L9,18</StreamGeometry>
  <StreamGeometry x:Key="IconExport">M12,4 V15 M7,10 L12,15 L17,10 M4,19 H20</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M5,7 H19 M10,7 V4 H14 V7 M7,7 L8,20 H16 L17,7</StreamGeometry>
  <StreamGeometry x:Key="IconChat">M4,5 H20 V16 H10 L6,20 V16 H4 Z</StreamGeometry>
  <StreamGeometry x:Key="IconShield">M12,3 L19,6 V11 C19,16 15.5,19.5 12,21 C8.5,19.5 5,16 5,11 V6 Z</StreamGeometry>
  <StreamGeometry x:Key="IconGlobe">M12,3 A9,9 0 1 1 11.99,3 Z M3,12 H21 M12,3 C9,6.5 9,17.5 12,21 M12,3 C15,6.5 15,17.5 12,21</StreamGeometry>
  <StreamGeometry x:Key="IconCompare">M8,4 V20 M16,4 V20 M4,8 H8 M16,16 H20 M4,16 L8,12 M16,8 L20,12</StreamGeometry>
  <StreamGeometry x:Key="IconMenu">M4,6 H20 M4,12 H20 M4,18 H20</StreamGeometry>
  <StreamGeometry x:Key="IconPlay">M7,4 L19,12 L7,20 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStop">M6,6 H18 V18 H6 Z</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M8,8 H20 V20 H8 Z M4,16 V4 H16</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M3,6 H10 L12,8 H21 V19 H3 Z</StreamGeometry>
  <StreamGeometry x:Key="IconKeyboard">M3,7 H21 V17 H3 Z M7,11 H7.1 M11,11 H11.1 M15,11 H15.1 M8,14 H16</StreamGeometry>
</ResourceDictionary>
