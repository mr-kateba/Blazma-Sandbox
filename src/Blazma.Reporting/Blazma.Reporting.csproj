<Project Sdk="Microsoft.NET.Sdk">
  <!-- Exporters: machine-readable JSON, a self-contained HTML report, a printable PDF, indicator lists, and Interop/ (STIX, MISP, Sigma, YARA, sample archives). -->
  <PropertyGroup>
    <RootNamespace>Blazma.Reporting</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blazma.Core\Blazma.Core.csproj" />
    <ProjectReference Include="..\Blazma.Storage\Blazma.Storage.csproj" />
    <ProjectReference Include="..\Blazma.Analysis\Blazma.Analysis.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpZipLib" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Blazma family fonts, embedded so PDF reports look the same on every computer (SIL OFL). -->
    <EmbeddedResource Include="..\..\assets\fonts\*.ttf" LogicalName="Blazma.Reporting.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
