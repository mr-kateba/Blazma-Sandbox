<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Blazma.App.ViewModels"
             xmlns:c="using:Blazma.App.Controls"
             xmlns:l="using:Blazma.App.Localization"
             x:Class="Blazma.App.Views.HistoryView" x:DataType="vm:HistoryViewModel">
  <UserControl.Styles>
    <!-- Fixed column widths keep the header and every row aligned; narrow windows drop the
         hash and environment columns (both are still in the report). -->
    <Style Selector=":is(Control).cSha"><Setter Property="Width" Value="140" /></Style>
    <Style Selector=":is(Control).cDate"><Setter Property="Width" Value="128" /></Style>
    <Style Selector=":is(Control).cScore"><Setter Property="Width" Value="48" /></Style>
    <Style Selector=":is(Control).cVerdict"><Setter Property="Width" Value="144" /></Style>
    <Style Selector=":is(Control).cDuration"><Setter Property="Width" Value="64" /></Style>
    <Style Selector=":is(Control).cEnv"><Setter Property="Width" Value="150" /></Style>
    <Style Selector=":is(Control).cStatus"><Setter Property="Width" Value="96" /></Style>
    <Style Selector=":is(Control).cActions"><Setter Property="Width" Value="172" /></Style>
    <Style Selector=":is(Control).cSha, :is(Control).cDate, :is(Control).cScore, :is(Control).cDuration, :is(Control).cEnv, :is(Control).cStatus">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <ContainerQuery Name="historyTable" Query="max-width:1080">
      <Style Selector=":is(Control).cSha, :is(Control).cEnv"><Setter Property="IsVisible" Value="False" /></Style>
    </ContainerQuery>
    <ContainerQuery Name="historyTable" Query="max-width:760">
      <Style Selector=":is(Control).cDuration, :is(Control).cDate"><Setter Property="IsVisible" Value="False" /></Style>
    </ContainerQuery>
  </UserControl.Styles>
  <DockPanel Margin="36,30,36,24">
    <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,14">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="{l:T NavHistory}" />
        <TextBlock Classes="caption" Text="{l:T HistorySubtitle}" />
      </StackPanel>
      <Grid ColumnDefinitions="*,12,180,12,180,12,Auto,16,Auto">
        <TextBox Text="{Binding Search}" PlaceholderText="{l:T HistorySearch}" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding Verdicts}" SelectedItem="{Binding Verdict}" HorizontalAlignment="Stretch" />
        <ComboBox Grid.Column="4" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" HorizontalAlignment="Stretch" />
        <CheckBox Grid.Column="6" Content="{l:T IncludeDemo}" IsChecked="{Binding IncludeDemo}" />
        <TextBlock Grid.Column="8" Classes="caption" Text="{Binding CountText}" VerticalAlignment="Center" />
      </Grid>
    </StackPanel>
    <Border Classes="card" Padding="6" Container.Name="historyTable" Container.Sizing="Width">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="12,6,12,8">
          <TextBlock Classes="caption" Text="{l:T File}" />
          <TextBlock Grid.Column="1" Classes="caption cSha" Text="SHA-256" />
          <TextBlock Grid.Column="2" Classes="caption cDate" Text="{l:T Date}" />
          <TextBlock Grid.Column="3" Classes="caption cScore" Text="{l:T Score}" />
          <TextBlock Grid.Column="4" Classes="caption cVerdict" Text="{l:T Verdict}" />
          <TextBlock Grid.Column="5" Classes="caption cDuration" Text="{l:T Duration}" />
          <TextBlock Grid.Column="6" Classes="caption cEnv" Text="{l:T Environment}" />
          <TextBlock Grid.Column="7" Classes="caption cStatus" Text="{l:T Status}" />
          <Border Grid.Column="8" Classes="cActions" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{l:T NoAnalysesYet}" Margin="12,14" IsVisible="{Binding IsEmpty}" />
        <ListBox Classes="rows" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AnalysisRow">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Background="Transparent" DoubleTapped="OnRowDoubleTapped">
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,8,0">
                  <Border Classes="badge banner demo" Padding="6,0" Margin="0,0,8,0" IsVisible="{Binding IsDemo}" VerticalAlignment="Center"><TextBlock Text="DEMO" FontSize="9.5" Foreground="{DynamicResource DemoTextBrush}" /></Border>
                  <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding FileName}" />
                </Grid>
                <TextBlock Grid.Column="1" Classes="mono faint cSha" Text="{Binding Sha256Short}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" />
                <TextBlock Grid.Column="2" Classes="mono muted cDate" Text="{Binding Date}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" />
                <TextBlock Grid.Column="3" Classes="mono cScore" Text="{Binding ScoreText}" VerticalAlignment="Center" FontSize="14" />
                <Panel Grid.Column="4" Classes="cVerdict"><c:RiskBadge Verdict="{Binding Verdict}" IsVisible="{Binding IsCompleted}" HorizontalAlignment="Left" /></Panel>
                <TextBlock Grid.Column="5" Classes="mono muted cDuration" Text="{Binding Duration}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Classes="muted cEnv" Text="{Binding Provider}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Provider}" />
                <TextBlock Grid.Column="7" Classes="muted cStatus" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="8" Classes="cActions" Orientation="Horizontal" Spacing="4">
                  <Button Classes="ghost" Padding="8,4" Content="{l:T Open}" Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
                  <Button Classes="ghost" Padding="6,4" ToolTip.Tip="{l:T Compare}" Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).CompareCommand}" CommandParameter="{Binding}">
                    <Path Classes="icon fixed" Data="{StaticResource IconCompare}" Width="14" Height="14" />
                  </Button>
                  <Button Classes="ghost" Padding="6,4" ToolTip.Tip="{l:T Export}" Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).ExportCommand}" CommandParameter="{Binding}">
                    <Path Classes="icon fixed" Data="{StaticResource IconExport}" Width="14" Height="14" />
                  </Button>
                  <Button Classes="ghost" Padding="6,4" ToolTip.Tip="{l:T Delete}" Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}">
                    <Path Classes="icon fixed" Data="{StaticResource IconTrash}" Width="14" Height="14" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
