<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests the agent's platform-independent logic (parsers, selection rules, the simulated internet's servers). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA2201;CA1063;CA1816;CA2000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Blazma.Agent\Blazma.Agent.csproj" />
    <ProjectReference Include="..\..\src\Blazma.Contracts\Blazma.Contracts.csproj" />
  </ItemGroup>
</Project>
